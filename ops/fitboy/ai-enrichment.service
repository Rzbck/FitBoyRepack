[Unit]
Description=FitBoyRepack AI metadata enrichment worker
After=network-online.target llama-server.service
Wants=network-online.target
Requires=llama-server.service

[Service]
Type=simple
User=fitboy
Group=fitboy
WorkingDirectory=/opt/FitBoyRepack
EnvironmentFile=/etc/llm/llm.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/FitBoyRepack/.venv/bin/python tools/ai_catalog_bootstrap.py --init --run --limit 0 --status --db /var/lib/fitboy/ai/catalog_enrichment.sqlite3 --sleep 0.1
Restart=on-failure
RestartSec=60
Nice=15
CPUQuota=50%
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
