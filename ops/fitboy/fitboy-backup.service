[Unit]
Description=FitBoyRepack consistent SQLite backup

[Service]
Type=oneshot
User=fitboy
Group=fitboy
ExecStart=/usr/bin/python3 /usr/local/libexec/fitboy/backup_sqlite.py
TimeoutStartSec=5min
Nice=19
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# SQLite WAL coordination may require transient shared-memory files in the source directories.
ReadWritePaths=/var/lib/fitboy/backups /var/lib/fitboy/ai /var/lib/fitboy/translation
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
