[Unit]
Description=FitBoyRepack read-only operational health monitor
After=network-online.target

[Service]
Type=oneshot
User=fitboy
Group=fitboy
ExecStart=/usr/bin/python3 /opt/FitBoyRepack/ops/fitboy/health_monitor.py
TimeoutStartSec=90s
Nice=19
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fitboy/health /var/lib/fitboy/ai /var/lib/fitboy/translation
