# Copy to /etc/llm/llm.env on the VPS.
# The model is intentionally not tied to FitBoyRepack.
MODEL_PATH=/var/lib/llm/models/model.gguf
LLM_HOST=127.0.0.1
LLM_PORT=8080
CTX_SIZE=4096
THREADS=2
PARALLEL=1

# Client-side defaults used by any local OpenAI-compatible consumer.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
LLM_TIMEOUT=120
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.1
